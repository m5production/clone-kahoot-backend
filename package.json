{
  "name": "clone-kahoot-backend",
  "packageManager": "yarn@1.22.22",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "dotenvx run -f .env.development -- nest start --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:ci": "biome ci .",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres postgres-test",
    "prisma-generate": "prisma generate",
    "prisma-seed-dev": "dotenvx run -f .env.development -- tsx prisma/seed.ts",
    "prisma-migrate-dev": "dotenvx run -f .env.development -- prisma migrate dev",
    "prisma-studio-dev": "dotenvx run -f .env.development -- prisma studio",
    "prisma-migrate-prod": "dotenvx run -f .env.production -- prisma migrate deploy"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.43.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-ws": "12.4.2",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/websockets": "12.4.2",
    "@prisma/client": "^6.6.0",
    "@types/ws": "^8.18.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "^5.1.0",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@nestjs/cli": "^12.0.13",
    "@types/express": "^5.0.1",
    "@types/node": "^26",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
