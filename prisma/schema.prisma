generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String          @unique @db.VarChar(64)
  passwordHash   String
  createdAt      DateTime        @default(now())
  games          Game[]
  sessions       Session[]
  hostedSessions GameSession[]
  sessionPlayers SessionPlayer[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id        String        @id @default(cuid())
  adminId   String
  admin     User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String        @db.VarChar(80)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  questions Question[]
  sessions  GameSession[]

  @@index([adminId])
}

model Question {
  id      String           @id @default(cuid())
  gameId  String
  game    Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order   Int
  img     String?          @db.VarChar(2048)
  text    String           @db.VarChar(300)
  // BR-48: time to answer; allowed values are enforced by a CHECK in the migration
  timeLimitSec Int            @default(20) @db.SmallInt
  answers AcceptedAnswer[]

  @@unique([gameId, order])
  @@index([gameId])
}

model AcceptedAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(100)

  @@index([questionId])
}

// History (stage 5): a finished or aborted live session. The quiz relation
// survives its deletion (SetNull); the title and questions are stored as copies
model GameSession {
  id        String           @id
  gameId    String?
  game      Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  hostId    String
  host      User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  quizTitle String           @db.VarChar(80)
  status    String           @default("running") @db.VarChar(16)
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  questions SessionQuestion[]
  players   SessionPlayer[]

  @@index([hostId])
  @@index([gameId])
}

model SessionQuestion {
  id              String          @id @default(cuid())
  sessionId       String
  session         GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position        Int
  text            String          @db.VarChar(300)
  img             String?         @db.VarChar(2048)
  timeLimitSec    Int             @db.SmallInt
  acceptedAnswers Json
  answers         SessionAnswer[]

  @@index([sessionId])
}

model SessionPlayer {
  id            String          @id @default(cuid())
  sessionId     String
  session       GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname      String          @db.VarChar(64)
  color         String          @db.VarChar(32)
  score         Int             @default(0)
  correctCount  Int             @default(0)
  correctTimeMs Int             @default(0)
  place         Int?
  answers       SessionAnswer[]

  @@unique([sessionId, userId])
  @@index([sessionId])
}

model SessionAnswer {
  id                String          @id @default(cuid())
  sessionPlayerId   String
  player            SessionPlayer   @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)
  sessionQuestionId String
  question          SessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  text              String          @db.VarChar(100)
  isCorrect         Boolean
  responseTimeMs    Int
  points            Int

  @@unique([sessionPlayerId, sessionQuestionId])
}
